; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MedTechDiagnosticsTycoon"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
GameData="*res://scripts/autoload/game_data.gd"
UIEvents="*res://scripts/autoload/ui_events.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
MusicManager="*res://scripts/audio/music_manager.gd"
SfxManager="*res://scripts/audio/sfx_manager.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
Tutorial="*res://scripts/autoload/tutorial.gd"
Responsive="*uid://c4jgpfj17tkrf"

[display]

window/size/viewport_width=1280.0
window/size/viewport_height=720.0
window/size/window_width_override=0.0
window/size/window_height_override=0.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4.0

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

[gui]

theme/custom="res://assets/ui/medtycoon_theme.tres"

