# Copy to .env for local development. Never commit .env; set real values in Railway variables.
NODE_ENV=development
PORT=3000

# MongoDB Atlas: dedicated MedTechTycoon dev user, readWrite on medtechtycoon_dev only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=medtechtycoon_dev

# Exact browser origin(s), comma-separated: scheme + host (+ port), no path.
ALLOWED_ORIGIN=https://jarcsys-collab.github.io

# Phase 3 (Microsoft Entra) - leave blank for now.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
